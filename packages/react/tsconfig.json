{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "declaration": true,
    "rootDir": "src", "outDir": "dist"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
