{
  "name": "@vesora/react",
  "version": "0.9.0-rc.4",
  "type": "module",
  "description": "Declarative React charts for SaaS dashboards, powered by Vesora",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/U-C4N/Vesora.git",
    "directory": "packages/react"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./viewer": {
      "types": "./dist/viewer.d.ts",
      "import": "./dist/viewer.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "@vesora/core": "0.9.0-rc.4"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
