{
  "name": "vesora-workspace",
  "private": true,
  "version": "0.9.0-rc.3",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/react",
    "examples/react-saas"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/react/tsconfig.json && tsc --noEmit -p examples/react-saas/tsconfig.json",
    "test": "vitest run tests/unit",
    "test:react": "vitest run tests/react",
    "test:saas": "playwright test --config playwright.saas.config.ts",
    "demo:react": "npm run dev --workspace vesora-react-saas-example",
    "build:example": "npm run build --workspace vesora-react-saas-example",
    "capture:readme": "npm run build:example && node scripts/capture-readme.mjs",
    "test:browser": "playwright test",
    "check": "npm run build && npm run typecheck && npm run test:release-contracts && npm test && npm run test:react && npm run build:example",
    "demo": "node scripts/serve.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:panels": "node scripts/benchmark-panels.mjs",
    "benchmark:statistics": "node scripts/benchmark-statistics.mjs",
    "benchmark:linked": "node scripts/benchmark-linked.mjs",
    "test:parity": "node scripts/parity.mjs",
    "test:examples": "node scripts/check-gallery-examples.mjs",
    "package:release": "node scripts/package-release.mjs",
    "test:packages": "node scripts/verify-packages.mjs && node scripts/verify-react-consumers.mjs",
    "test:consumers": "node scripts/verify-react-consumers.mjs",
    "publish:packages": "node scripts/publish-release.mjs",
    "test:release": "node scripts/verify-release.mjs",
    "test:release-contracts": "node --test tests/scripts/release-validation.test.mjs tests/scripts/github-release.test.mjs",
    "init:release-gates": "node scripts/init-release-gates.mjs",
    "benchmark:streaming": "node scripts/benchmark-v09.mjs stream",
    "verify:published": "node scripts/verify-published.mjs",
    "benchmark:prism": "node scripts/benchmark-v09.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
