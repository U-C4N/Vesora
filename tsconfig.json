{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "skipLibCheck": true, "declaration": true, "outDir": "packages/core/dist",
    "rootDir": "packages/core/src", "noUncheckedIndexedAccess": false
  },
  "include": ["packages/core/src/**/*.ts"]
}
